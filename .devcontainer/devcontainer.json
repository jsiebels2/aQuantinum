{
  "name": "aQuantinum (CPU)",
  "build": {
    "dockerfile": "Dockerfile"
  },
  "remoteUser": "vscode",

  "customizations": {
    "vscode": {
      "extensions": [
        "ms-vscode.cmake-tools",
        "llvm-vs-code-extensions.vscode-clangd",
        "ms-python.python"
      ],
      "settings": {
        "cmake.useCMakePresets": "always",
        "cmake.configureOnOpen": false,
        "C_Cpp.intelliSenseEngine": "disabled",
        "clangd.arguments": [
          "--compile-commands-dir=${workspaceFolder}/build/container-release"
        ],
        "python.defaultInterpreterPath": "${workspaceFolder}/.venv/bin/python"
      }
    }
  },

  "postCreateCommand": "python3 -m venv .venv && .venv/bin/pip install --upgrade pip numpy matplotlib pytest && cmake --preset container-release"
}